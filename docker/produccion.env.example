# Configuración de producción. Copie este archivo a docker/produccion.env
# (no se versiona) y complete los valores marcados con CAMBIAR.
# Ver docs/despliegue.md.

# --- Aplicación ---------------------------------------------------------------
APP_NAME="Sistema de Matrices de Riesgo"
APP_ENV=production
# Genérela con: docker compose run --rm --no-deps --entrypoint php app artisan key:generate --show
APP_KEY=CAMBIAR
APP_DEBUG=false
# Mismo dominio para la SPA y la API.
APP_URL=https://riesgos.CAMBIAR
FRONTEND_URL=https://riesgos.CAMBIAR
APP_LOCALE=es
APP_FALLBACK_LOCALE=en
MATRIZ_FORMULARIO_CODIGO=RT-01-NI-ONA-156
MATRIZ_FORMULARIO_EDICION="Edición 1"

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# --- Sesión y Sanctum (cookies) ---------------------------------------------------
# Dominio sin https:// ni barra final. Sanctum solo trata como SPA las peticiones de aquí.
SANCTUM_STATEFUL_DOMAINS=riesgos.CAMBIAR
SESSION_DRIVER=database
SESSION_LIFETIME=4
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=null

# --- Base de datos ------------------------------------------------------------
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=matriz_riesgo
DB_USERNAME=matriz_riesgo
DB_PASSWORD=CAMBIAR

# Las lee el contenedor de MariaDB al crear la base de datos por primera vez.
MARIADB_DATABASE=matriz_riesgo
MARIADB_USER=matriz_riesgo
MARIADB_PASSWORD=CAMBIAR
MARIADB_ROOT_PASSWORD=CAMBIAR

# --- Cola, caché y archivos ------------------------------------------------------
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local
BCRYPT_ROUNDS=12

# --- Correo (SMTP institucional) ---------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=CAMBIAR
MAIL_PORT=587
MAIL_USERNAME=CAMBIAR
MAIL_PASSWORD=CAMBIAR
MAIL_FROM_ADDRESS=CAMBIAR
MAIL_FROM_NAME="Sistema de Matrices de Riesgo"
